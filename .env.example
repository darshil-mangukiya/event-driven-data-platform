ENVIRONMENT=local
LOG_LEVEL=INFO

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_DB=data_platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
# `platform` is a PostgreSQL SUPERUSER (created via POSTGRES_USER/PASSWORD
# above, which the postgres image's own bootstrap requires to be a
# superuser) — it unconditionally bypasses row-level security and is used
# by the postgres container's own init/bootstrap only. It is NOT the
# runtime identity of any application service by default; see
# docker-compose.yml, where every service overrides DATABASE_URL with
# either platform_tenant_scoped (tenant-facing/per-event-scoped traffic;
# NOSUPERUSER, NOBYPASSRLS) or platform_admin_bypass (privileged
# background/administrative traffic; NOSUPERUSER, BYPASSRLS) — both
# created automatically by database/security/tenant_rls.sql on a fresh
# Postgres init (see database/init/004_apply_tenant_rls.sql). This
# DATABASE_URL remains here as the default for anything that doesn't
# override it (ad hoc scripts, `psql`, migrations) and as the fallback if
# a service is run outside docker-compose.yml.
# See evidence/validation/application-rls-runtime-verification.md.
DATABASE_URL=postgresql://platform:platform@postgres:5432/data_platform

REDIS_URL=redis://redis:6379/0

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLIENT_ID=data-platform-local
KAFKA_CONSUMER_GROUP=processing-service
KAFKA_ENABLE_CONSUMER=true

JWT_ISSUER=platform.local
JWT_AUDIENCE=data-platform
JWT_SECRET=local-development-secret-change-me
DEFAULT_CACHE_TTL_SECONDS=120
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# OpenTelemetry distributed tracing (platform_shared.tracing) — disabled
# by default; the platform runs identically with or without a tracing
# backend. Set OTEL_ENABLED=true and point OTEL_EXPORTER_OTLP_ENDPOINT at
# a real OTLP/HTTP collector (e.g. a local Jaeger: `docker run -p 16686:16686
# -p 4318:4318 jaegertracing/all-in-one`) to enable it. Live-verified
# against a real Jaeger instance — see docs/observability-tracing.md.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Local demos use caller-supplied identity headers. Restrict this mode to an
# isolated development environment. Set AUTH_MODE=strict for shared deployments.
# See docs/security.md and scripts/validate_auth_posture.py.
AUTH_MODE=dev_compat

SPARK_MASTER_URL=spark://spark-master:7077
S3_ENDPOINT=http://minio:9000
S3_BUCKET=data-platform
AWS_ACCESS_KEY_ID=platform
AWS_SECRET_ACCESS_KEY=local-minio-secret-change-me
MINIO_ROOT_USER=platform
MINIO_ROOT_PASSWORD=local-minio-secret-change-me

# Structured Streaming (spark/streaming/) — see docs/streaming_architecture.md.
# Falls back to sensible local defaults if unset; only override for a
# non-default local run (e.g. a single-tenant demo).
STREAMING_SUBSCRIBE_TOPICS=platform.events.orders,platform.events.payments,platform.events.users,platform.events.products,platform.events.system
STREAMING_STARTING_OFFSETS=latest
STREAMING_TRIGGER_INTERVAL=30 seconds
STREAMING_WATERMARK_DELAY=10 minutes
STREAMING_WINDOW_DURATION=5 minutes
STREAMING_LATE_ACCEPT_THRESHOLD_SECONDS=60
STREAMING_LATE_REJECT_THRESHOLD_SECONDS=600
STREAMING_CHECKPOINT_ROOT=/tmp/spark/checkpoints/cloudscale-streaming
STREAMING_TENANT_FILTER=
STREAMING_DLQ_TOPIC=platform.events.dlq
STREAMING_METRICS_PORT=8007
STREAMING_SINK_MAX_RETRIES=3
STREAMING_SINK_RETRY_BACKOFF_SECONDS=0.5
