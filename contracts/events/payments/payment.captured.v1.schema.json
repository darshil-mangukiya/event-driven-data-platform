{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data-platform.local/contracts/events/payments/payment.captured.v1.schema.json",
  "title": "payment.captured v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["payment_id", "order_id", "customer_id", "amount", "status", "payment_method"],
  "properties": {
    "payment_id": {"type": "string", "minLength": 1},
    "order_id": {"type": "string", "minLength": 1},
    "customer_id": {"type": "string", "minLength": 1},
    "amount": {"type": "number", "minimum": 0},
    "currency": {"type": "string", "minLength": 3, "maxLength": 3},
    "status": {"type": "string", "enum": ["authorized", "captured", "failed"]},
    "payment_method": {"type": "string"},
    "failure_code": {"type": ["string", "null"]},
    "risk_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
  }
}
